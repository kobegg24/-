<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>校园财诊通 · 你的大学财务医生</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0}
body{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  background:#dfe6f0;color:#0f172a;-webkit-font-smoothing:antialiased;
}
#app{
  max-width:430px;margin:0 auto;min-height:100vh;background:#f4f6fb;
  position:relative;padding-bottom:96px;box-shadow:0 0 60px rgba(15,23,42,.14);overflow-x:hidden;
}

/* ---------- 顶栏 ---------- */
.topbar{
  position:sticky;top:0;z-index:30;
  display:flex;align-items:center;justify-content:space-between;
  padding:18px 18px 16px;
  background:linear-gradient(135deg,#1d4ed8 0%,#0ea5e9 100%);
  color:#fff;border-radius:0 0 24px 24px;
  box-shadow:0 6px 22px rgba(29,78,216,.28);
}
.brand{display:flex;align-items:center;gap:10px}
.logo{
  width:40px;height:40px;border-radius:13px;background:rgba(255,255,255,.2);
  display:grid;place-items:center;font-weight:800;font-size:17px;
  backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.25);
}
.topbar h1{margin:0;font-size:17px;font-weight:700;letter-spacing:.3px}
.topbar p{margin:2px 0 0;font-size:11px;opacity:.82}

/* ---------- 通用 ---------- */
main{padding:14px 14px 0}
.view{display:none;animation:fade .28s ease}
.view.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

.card{
  background:#fff;border-radius:18px;padding:16px;margin-bottom:13px;
  box-shadow:0 2px 10px rgba(15,23,42,.05);
}
.card-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.card-head h3{margin:0;font-size:14.5px;font-weight:700;letter-spacing:.2px}
.link{
  background:none;border:none;color:#0ea5e9;font-size:12.5px;font-weight:600;
  cursor:pointer;padding:2px 4px;
}
.link.danger{color:#ef4444}
.hint{margin:0 0 12px;font-size:12px;color:#64748b;line-height:1.6}

/* ---------- 首页 hero ---------- */
.hero{
  background:linear-gradient(140deg,#1e40af 0%,#2563eb 45%,#0ea5e9 100%);
  color:#fff;border-radius:22px;padding:20px 18px 16px;
  box-shadow:0 10px 26px rgba(37,99,235,.32);position:relative;overflow:hidden;
}
.hero::after{
  content:"";position:absolute;width:190px;height:190px;border-radius:50%;
  background:rgba(255,255,255,.09);top:-90px;right:-60px;
}
.hero-label{font-size:12px;opacity:.85;letter-spacing:.5px}
.hero-amount{font-size:38px;font-weight:800;margin:6px 0 2px;letter-spacing:-.5px}
.hero-amount.neg{color:#fecaca}
.hero-sub{font-size:12px;opacity:.85;margin-bottom:14px}
.bar{height:7px;border-radius:99px;background:rgba(255,255,255,.24);overflow:hidden}
.bar-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,#fbbf24,#f472b6);transition:width .5s ease}
.hero-foot{display:flex;justify-content:space-between;font-size:11.5px;opacity:.9;margin-top:10px;position:relative;z-index:1}

/* ---------- 预警 ---------- */
.alert{
  border-radius:16px;padding:13px 15px;margin-bottom:13px;font-size:13px;
  display:flex;gap:10px;align-items:flex-start;line-height:1.55;
  animation:pop .3s ease;
}
@keyframes pop{from{opacity:0;transform:scale(.97)}to{opacity:1;transform:none}}
.alert.warn{background:#fff7ed;border:1px solid #fed7aa;color:#9a3412}
.alert.danger{background:#fef2f2;border:1px solid #fecaca;color:#b91c1c}
.alert.info{background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af}
.alert b{display:block;margin-bottom:2px;font-size:13px}
.alert .ico{font-size:17px;line-height:1.2}

/* ---------- 双卡 ---------- */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:13px}
.mini{margin:0;padding:14px}
.mini-label{font-size:11.5px;color:#64748b;margin-bottom:6px}
.mini-value{font-size:19px;font-weight:800;color:#0f172a}
.mini-note{font-size:11px;color:#94a3b8;margin-top:4px;line-height:1.5}
.mini-note.warn{color:#f97316;font-weight:600}
.mini-note.ok{color:#10b981;font-weight:600}
.mini-bar{height:5px;border-radius:99px;background:#eef2f7;margin-top:8px;overflow:hidden}
.mini-bar i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,#34d399,#0ea5e9)}

/* ---------- 快捷操作 ---------- */
.quick{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.quick button{
  background:#f8fafc;border:1px solid #eef2f7;border-radius:14px;
  padding:12px 2px;display:flex;flex-direction:column;align-items:center;gap:6px;
  font-size:11.5px;color:#475569;font-weight:600;cursor:pointer;transition:.18s;
}
.quick button:active{transform:scale(.94);background:#eff6ff;border-color:#bfdbfe}
.quick button span{font-size:19px}

/* ---------- 交易列表 ---------- */
.tx-list{display:flex;flex-direction:column}
.tx-item{display:flex;align-items:center;gap:11px;padding:10px 0;border-bottom:1px solid #f1f5f9}
.tx-item:last-child{border-bottom:none}
.tx-icon{
  width:40px;height:40px;border-radius:13px;display:grid;place-items:center;
  font-size:18px;flex-shrink:0;
}
.tx-main{flex:1;min-width:0}
.tx-note{font-size:13.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tx-meta{font-size:11px;color:#94a3b8;margin-top:2px}
.tx-amount{font-size:14.5px;font-weight:700;white-space:nowrap}
.tx-amount.expense{color:#0f172a}
.tx-amount.income{color:#10b981}
.tx-del{
  background:none;border:none;color:#cbd5e1;font-size:16px;cursor:pointer;
  padding:2px 0 2px 6px;line-height:1;
}
.tx-del:active{color:#ef4444}
.empty{text-align:center;color:#94a3b8;font-size:12.5px;padding:26px 0}

/* ---------- 账单页统计 ---------- */
.stats3{display:grid;grid-template-columns:repeat(3,1fr);text-align:center}
.stats3 b{display:block;font-size:17px;font-weight:800}
.stats3 span{font-size:11px;color:#94a3b8}
.day-head{
  font-size:11.5px;color:#94a3b8;font-weight:600;
  padding:12px 0 4px;letter-spacing:.3px;
}

/* ---------- 记账页 ---------- */
.seg{display:flex;background:#f1f5f9;border-radius:13px;padding:4px;margin-bottom:18px}
.seg button{
  flex:1;border:none;background:none;padding:9px;border-radius:10px;
  font-size:13.5px;font-weight:700;color:#64748b;cursor:pointer;transition:.2s;
}
.seg button.active{background:#fff;color:#1d4ed8;box-shadow:0 2px 8px rgba(15,23,42,.09)}

.amount-wrap{
  display:flex;align-items:baseline;gap:8px;
  border-bottom:2px solid #eef2f7;padding:4px 2px 12px;margin-bottom:18px;
}
.amount-wrap span{font-size:26px;font-weight:800;color:#1d4ed8}
.amount-wrap input{
  flex:1;border:none;outline:none;font-size:36px;font-weight:800;
  color:#0f172a;background:transparent;width:100%;letter-spacing:-1px;
}
.amount-wrap input::placeholder{color:#cbd5e1}

.field{margin-bottom:16px}
.field label{display:block;font-size:12px;color:#64748b;font-weight:600;margin-bottom:8px}
.input{
  width:100%;border:1.5px solid #e8edf5;border-radius:12px;padding:11px 13px;
  font-size:14px;outline:none;background:#fbfcfe;color:#0f172a;
  font-family:inherit;transition:.2s;
}
.input:focus{border-color:#93c5fd;background:#fff;box-shadow:0 0 0 3px rgba(59,130,246,.1)}
textarea.input{resize:vertical;line-height:1.6}

.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{
  border:1.5px solid #e8edf5;background:#fbfcfe;border-radius:11px;
  padding:8px 12px;font-size:12.5px;color:#475569;cursor:pointer;
  display:flex;align-items:center;gap:5px;transition:.18s;font-weight:600;
}
.chip.active{background:#eff6ff;border-color:#60a5fa;color:#1d4ed8}
.chip:active{transform:scale(.94)}

.btn{
  width:100%;border:none;border-radius:14px;padding:14px;
  font-size:14.5px;font-weight:700;cursor:pointer;font-family:inherit;
  transition:.18s;letter-spacing:.3px;
}
.btn:active{transform:scale(.975)}
.btn.primary{
  background:linear-gradient(135deg,#2563eb,#0ea5e9);color:#fff;
  box-shadow:0 6px 18px rgba(37,99,235,.3);
}
.btn.ghost{background:#f1f5f9;color:#334155;margin-top:12px}
.btn.ghost.danger{background:#fef2f2;color:#dc2626}
.btn:disabled{opacity:.6;cursor:not-allowed}

/* ---------- 图片导入 ---------- */
.upload{
  border:2px dashed #cbd5e1;border-radius:16px;padding:26px 14px;
  text-align:center;color:#64748b;font-size:13px;cursor:pointer;
  background:#fbfcfe;transition:.2s;
}
.upload:active{border-color:#60a5fa;background:#eff6ff}
.upload-icon{font-size:28px;margin-bottom:8px}
.upload small{display:block;color:#94a3b8;font-size:11px;margin-top:4px}
.preview{width:100%;border-radius:14px;margin-top:12px;display:block;border:1px solid #eef2f7}

.scanning{
  margin-top:14px;padding:20px;text-align:center;color:#1d4ed8;font-size:13px;
  font-weight:600;background:#eff6ff;border-radius:14px;position:relative;overflow:hidden;
}
.scan-bar{
  position:absolute;left:0;top:0;height:100%;width:40%;
  background:linear-gradient(90deg,transparent,rgba(59,130,246,.25),transparent);
  animation:scan 1.1s linear infinite;
}
@keyframes scan{from{transform:translateX(-100%)}to{transform:translateX(350%)}}

.ocr-head{font-size:12.5px;color:#64748b;margin:16px 0 8px;font-weight:600}
.ocr-item{
  display:flex;align-items:center;gap:9px;padding:10px 12px;
  background:#f8fafc;border-radius:12px;margin-bottom:7px;font-size:12.5px;
}
.ocr-item input[type=checkbox]{width:16px;height:16px;accent-color:#2563eb;flex-shrink:0}
.ocat{padding:3px 8px;border-radius:8px;font-size:11px;font-weight:700;white-space:nowrap}
.onote{flex:1;color:#475569;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ocr-item b{color:#0f172a}

/* ---------- AI 诊断 ---------- */
.doctor-card{background:linear-gradient(150deg,#0f172a,#1e3a8a 60%,#0c4a6e);color:#fff;border:none}
.doctor-head{display:flex;gap:12px;align-items:center;margin-bottom:18px}
.avatar{
  width:46px;height:46px;border-radius:15px;background:rgba(255,255,255,.14);
  display:grid;place-items:center;font-size:22px;border:1px solid rgba(255,255,255,.2);
}
.doctor-head h3{margin:0;font-size:15px}
.doctor-head p{margin:3px 0 0;font-size:11.5px;opacity:.72}

.score-wrap{display:flex;align-items:center;gap:16px}
.score-ring{
  width:88px;height:88px;border-radius:50%;flex-shrink:0;
  display:grid;place-items:center;position:relative;
  background:conic-gradient(#38bdf8 0deg,#1e293b 0deg);
  transition:background .8s ease;
}
.score-ring::after{content:"";position:absolute;inset:7px;background:#0f172a;border-radius:50%}
.score-ring span{position:relative;z-index:1;font-size:24px;font-weight:800;color:#fff}
.score-info b{font-size:15px;display:block;margin-bottom:5px}
.score-info p{margin:0;font-size:11.5px;line-height:1.6;opacity:.78}

.cat-chart{display:flex;flex-direction:column;gap:11px}
.cat-row{display:grid;grid-template-columns:74px 1fr 36px 62px;align-items:center;gap:9px;font-size:11.5px}
.cat-name{color:#475569;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cat-bar{height:8px;border-radius:99px;background:#eef2f7;overflow:hidden}
.cat-bar i{display:block;height:100%;border-radius:99px;transition:width .6s ease}
.cat-pct{color:#94a3b8;text-align:right}
.cat-amt{color:#0f172a;font-weight:700;text-align:right}

.advice-list{display:flex;flex-direction:column;gap:10px}
.advice{
  display:flex;gap:11px;padding:12px;border-radius:14px;
  background:#f8fafc;font-size:12.5px;line-height:1.65;color:#475569;
}
.advice.good{background:#f0fdf4}
.advice.bad{background:#fff7ed}
.advice .ai{font-size:17px;line-height:1.25}
.advice b{display:block;color:#0f172a;margin-bottom:3px;font-size:13px}
.advice.good b{color:#15803d}
.advice.bad b{color:#c2410c}

/* ---------- 设置 ---------- */
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.switch-row{display:flex;align-items:center;justify-content:space-between;font-size:13.5px;font-weight:600;color:#334155}
.switch{width:44px;height:25px;appearance:none;background:#cbd5e1;border-radius:99px;position:relative;transition:.25s;cursor:pointer;flex-shrink:0}
.switch::after{content:"";position:absolute;width:19px;height:19px;border-radius:50%;background:#fff;top:3px;left:3px;transition:.25s;box-shadow:0 1px 4px rgba(0,0,0,.2)}
.switch:checked{background:#2563eb}
.switch:checked::after{left:22px}

/* ---------- 底部导航 ---------- */
.tabbar{
  position:fixed;bottom:0;left:50%;transform:translateX(-50%);
  width:100%;max-width:430px;z-index:40;
  display:flex;align-items:center;justify-content:space-around;
  background:rgba(255,255,255,.94);backdrop-filter:blur(14px);
  border-top:1px solid #eef2f7;padding:8px 0 max(8px,env(safe-area-inset-bottom));
}
.tabbar button{
  background:none;border:none;display:flex;flex-direction:column;align-items:center;
  gap:3px;font-size:10.5px;color:#94a3b8;cursor:pointer;font-family:inherit;
  font-weight:600;flex:1;padding:4px 0;transition:.2s;
}
.tabbar button i{font-style:normal;font-size:19px;line-height:1}
.tabbar button.active{color:#2563eb}
.tabbar .add-btn{flex:0 0 auto;position:relative;top:-14px}
.tabbar .add-btn i{
  width:52px;height:52px;border-radius:50%;display:grid;place-items:center;
  background:linear-gradient(135deg,#2563eb,#0ea5e9);color:#fff;font-size:27px;
  box-shadow:0 7px 20px rgba(37,99,235,.42);
}
.tabbar .add-btn span{display:none}

/* ---------- Toast ---------- */
#toast{
  position:fixed;left:50%;bottom:118px;transform:translateX(-50%) translateY(20px);
  background:rgba(15,23,42,.9);color:#fff;padding:11px 20px;border-radius:99px;
  font-size:13px;font-weight:600;opacity:0;pointer-events:none;transition:.3s;z-index:99;
  max-width:80vw;text-align:center;
}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
</style>
</head>
<body>
<div id="app">

  <!-- ============ 顶栏 ============ -->
  <header class="topbar">
    <div class="brand">
      <div class="logo">财</div>
      <div>
        <h1>校园财诊通</h1>
        <p>你的大学财务医生</p>
      </div>
    </div>
    <div style="font-size:20px;opacity:.85">🩺</div>
  </header>

  <main id="main">

    <!-- ============ 首页 ============ -->
    <section id="v-home" class="view active">
      <div class="card hero">
        <div class="hero-label">本周期可用余额（已扣除预留）</div>
        <div class="hero-amount" id="heroAmount">¥0.00</div>
        <div class="hero-sub" id="heroSub">加载中…</div>
        <div class="bar"><div class="bar-fill" id="heroBar" style="width:0%"></div></div>
        <div class="hero-foot">
          <span id="heroSpent">已支出 ¥0</span>
          <span id="heroLeft">距发放 0 天</span>
        </div>
      </div>

      <div id="alertBox"></div>

      <div class="grid2">
        <div class="card mini">
          <div class="mini-label">🛡️ 资金预留</div>
          <div class="mini-value" id="reserveVal">¥0</div>
          <div class="mini-note" id="reserveNote">未设置</div>
          <div class="mini-bar"><i id="reserveBar" style="width:0%"></i></div>
        </div>
        <div class="card mini">
          <div class="mini-label">🎯 存钱目标</div>
          <div class="mini-value" id="savingVal">¥0</div>
          <div class="mini-note" id="savingNote">未设置</div>
          <div class="mini-bar"><i id="savingBar" style="width:0%"></i></div>
        </div>
      </div>

      <div class="card">
        <div class="card-head"><h3>快捷操作</h3></div>
        <div class="quick">
          <button onclick="go('add')"><span>✍️</span>记一笔</button>
          <button onclick="go('add');setTimeout(()=>document.getElementById('dropZone').scrollIntoView({behavior:'smooth',block:'center'}),200)"><span>📷</span>截图导入</button>
          <button onclick="go('ai')"><span>🩺</span>财务诊断</button>
          <button onclick="go('set')"><span>⚙️</span>预算设置</button>
        </div>
      </div>

      <div class="card">
        <div class="card-head">
          <h3>最近账单</h3>
          <button class="link" onclick="go('list')">全部 ›</button>
        </div>
        <div id="recentList" class="tx-list"></div>
      </div>
    </section>

    <!-- ============ 账单 ============ -->
    <section id="v-list" class="view">
      <div class="card">
        <div class="card-head"><h3>本周期概览</h3></div>
        <div class="stats3">
          <div><b id="lsExpense">¥0</b><span>支出</span></div>
          <div><b id="lsIncome">¥0</b><span>收入</span></div>
          <div><b id="lsCount">0</b><span>笔数</span></div>
        </div>
      </div>
      <div class="card">
        <div class="card-head">
          <h3>全部账单</h3>
          <button class="link danger" onclick="clearAll()">清空</button>
        </div>
        <div id="txList" class="tx-list"></div>
      </div>
    </section>

    <!-- ============ 记一笔 ============ -->
    <section id="v-add" class="view">
      <div class="card">
        <div class="seg" id="typeSeg">
          <button class="active" data-type="expense">支出</button>
          <button data-type="income">收入</button>
        </div>
        <div class="amount-wrap">
          <span>¥</span>
          <input id="amountInput" type="text" inputmode="decimal" placeholder="0.00">
        </div>
        <div class="field">
          <label>分类</label>
          <div class="chips" id="catChips"></div>
        </div>
        <div class="field">
          <label>备注</label>
          <input id="noteInput" class="input" placeholder="例如：食堂午饭">
        </div>
        <div class="field">
          <label>日期</label>
          <input id="dateInput" class="input" type="date">
        </div>
        <button class="btn primary" onclick="saveTx()">保存这笔账单</button>
      </div>

      <div class="card">
        <div class="card-head"><h3>📷 账单截图导入</h3></div>
        <p class="hint">上传微信 / 支付宝账单截图，AI 自动识别金额、商家并智能分类，确认后一键入账。</p>
        <div class="upload" id="dropZone" onclick="pickFile()">
          <div class="upload-icon">🖼️</div>
          <div>点击上传账单截图</div>
          <small>支持 JPG / PNG</small>
        </div>
        <input type="file" id="fileInput" accept="image/*" hidden>
        <img id="preview" class="preview" hidden alt="账单预览">
        <button class="btn ghost" id="ocrBtn" hidden onclick="runOCR()">开始 AI 识别</button>
        <div id="ocrResult"></div>
      </div>

      <div class="card">
        <div class="card-head"><h3>📝 粘贴账单文本</h3></div>
        <p class="hint">从账单里复制文字，每行一条，例如：<br>2026-09-12 美团外卖 25.00</p>
        <textarea id="billText" class="input" rows="4" placeholder="2026-09-12 美团外卖 25.00&#10;2026-09-12 地铁乘车码 6.00&#10;2026-09-13 食堂午饭 18.00"></textarea>
        <button class="btn ghost" onclick="parseText()">解析并导入</button>
      </div>
    </section>

    <!-- ============ AI 诊断 ============ -->
    <section id="v-ai" class="view">
      <div class="card doctor-card">
        <div class="doctor-head">
          <div class="avatar">🩺</div>
          <div>
            <h3>财务医生 · AI 诊断</h3>
            <p>会计学诊断模型 + AI 智能分析</p>
          </div>
        </div>
        <div class="score-wrap">
          <div class="score-ring" id="scoreRing"><span id="scoreNum">--</span></div>
          <div class="score-info">
            <b id="scoreLevel">待诊断</b>
            <p id="scoreDesc">正在读取你的消费数据…</p>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-head"><h3>消费结构分析</h3></div>
        <div id="catChart" class="cat-chart"></div>
      </div>

      <div class="card">
        <div class="card-head"><h3>医生建议</h3></div>
        <div id="adviceList" class="advice-list"></div>
      </div>

