<div id="toast"></div>

<script>
/* =========================================================
   校园财诊通 · 核心逻辑
   ========================================================= */

/* ---------------- 工具函数 ---------------- */
const $  = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
const pad = n => String(n).padStart(2, '0');
const ymd = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
const parseYmd = s => { const [y, m, d] = s.split('-').map(Number); return new Date(y, m - 1, d); };
const fmt = n => (Math.round(n * 100) / 100).toFixed(2);
const uid = () => Math.random().toString(36).slice(2, 10);
const DAY = 86400000;

function toast(msg) {
  const el = $('#toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(el._t);
  el._t = setTimeout(() => el.classList.remove('show'), 1900);
}

/* ---------------- 分类字典 ---------------- */
const CATS = {
  expense: [
    { key: 'food',      name: '餐饮', icon: '🍜', color: '#f97316' },
    { key: 'transport', name: '交通', icon: '🚌', color: '#3b82f6' },
    { key: 'entertain', name: '娱乐', icon: '🎮', color: '#a855f7' },
    { key: 'study',     name: '学习', icon: '📚', color: '#10b981' },
    { key: 'shopping',  name: '购物', icon: '🛍️', color: '#ec4899' },
    { key: 'daily',     name: '日用', icon: '🧴', color: '#14b8a6' },
    { key: 'social',    name: '社交', icon: '🍻', color: '#ef4444' },
    { key: 'medical',   name: '医疗', icon: '💊', color: '#06b6d4' },
    { key: 'other',     name: '其他', icon: '📦', color: '#94a3b8' }
  ],
  income: [
    { key: 'living',      name: '生活费', icon: '💰', color: '#10b981' },
    { key: 'parttime',    name: '兼职',   icon: '💼', color: '#3b82f6' },
    { key: 'scholarship', name: '奖学金', icon: '🏅', color: '#f59e0b' },
    { key: 'other_in',    name: '其他',   icon: '📥', color: '#94a3b8' }
  ]
};
const CAT_MAP = {};
Object.values(CATS).flat().forEach(c => CAT_MAP[c.key] = c);
const catName  = k => (CAT_MAP[k] || {}).name  || '其他';
const catIcon  = k => (CAT_MAP[k] || {}).icon  || '📦';
const catColor = k => (CAT_MAP[k] || {}).color || '#94a3b8';

/* ---------------- 关键词自动分类 ---------------- */
const KEYWORDS = {
  food: ['食堂','餐','饭','美团','饿了么','外卖','奶茶','咖啡','烧烤','火锅','麦当劳','肯德基','瑞幸','星巴克','蜜雪','水果','小吃','面','粉','超市食品'],
  transport: ['公交','地铁','滴滴','打车','高铁','火车','机票','共享单车','哈啰','青桔','加油','交通','乘车码','出租'],
  entertain: ['电影','KTV','游戏','腾讯视频','爱奇艺','哔哩哔哩','b站','网易云','音乐','密室','剧本杀','网吧','会员','充值'],
  study: ['书店','图书','文具','打印','课程','网课','考试','四六级','教材','知网','培训','资料'],
  shopping: ['淘宝','京东','拼多多','唯品会','服装','鞋','化妆品','数码','天猫','商城','旗舰店'],
  daily: ['超市','日用','洗发','纸巾','洗衣','话费','电费','水费','宿舍','牙膏','沐浴'],
  social: ['聚餐','请客','团建','礼物','红包','K歌','聚会'],
  medical: ['药店','医院','药','门诊','体检','挂号']
};

function guessCat(text) {
  const t = (text || '').toLowerCase();
  let best = 'other', bestLen = 0;
  for (const [cat, words] of Object.entries(KEYWORDS)) {
    for (const w of words) {
      if (t.includes(w.toLowerCase()) && w.length > bestLen) {
        best = cat; bestLen = w.length;
      }
    }
  }
  return best;
}

/* ---------------- 状态 ---------------- */
const KEY = 'campus_finance_v1';

const DEFAULT_SETTINGS = {
  livingFee: 1500,
  payday: 10,
  reserveName: '火车票',
  reserveAmount: 200,
  savingName: '旅行基金',
  savingTarget: 1000,
  savingCurrent: 350,
  alerts: true
};

let S = loadState();

function loadState() {
  try {
    const raw = localStorage.getItem(KEY);
    if (raw) {
      const obj = JSON.parse(raw);
      obj.settings = Object.assign({}, DEFAULT_SETTINGS, obj.settings || {});
      obj.transactions = obj.transactions || [];
      return obj;
    }
  } catch (e) { /* ignore */ }
  return buildSeed();
}

function save() {
  try { localStorage.setItem(KEY, JSON.stringify(S)); } catch (e) {}
}

/* ---------------- 生活费周期 ---------------- */
function cycleRange() {
  const payday = Number(S.settings.payday) || 1;
  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  let start, end;
  if (today.getDate() >= payday) {
    start = new Date(today.getFullYear(), today.getMonth(), payday);
    end   = new Date(today.getFullYear(), today.getMonth() + 1, payday);
  } else {
    start = new Date(today.getFullYear(), today.getMonth() - 1, payday);
    end   = new Date(today.getFullYear(), today.getMonth(), payday);
  }
  return { start, end, today };
}

function inRange(dateStr, a, b) {
  const d = parseYmd(dateStr);
  return d >= a && d < b;
}

/* ---------------- 核心统计 ---------------- */
function cycleStats() {
  const { start, end, today } = cycleRange();
  const list = S.transactions.filter(t => inRange(t.date, start, end));
  const expense = list.filter(t => t.type === 'expense').reduce((s, t) => s + t.amount, 0);
  const income  = list.filter(t => t.type === 'income').reduce((s, t) => s + t.amount, 0);

  const daysLeft = Math.max(1, Math.ceil((end - today) / DAY));
  const livingFee = Number(S.settings.livingFee) || 0;
  const reserve   = Number(S.settings.reserveAmount) || 0;

  const remain    = livingFee - expense;          // 剩余生活费
  const available = remain - reserve;             // 扣除预留后可支配
  const safeDaily = Math.max(available, 0) / daysLeft;

  // 近 7 天日均支出
  const d7start = new Date(today.getTime() - 6 * DAY);
  const recent = S.transactions.filter(t =>
    t.type === 'expense' &&
    parseYmd(t.date) >= d7start &&
    parseYmd(t.date) <= today
  );
  const avg7 = recent.reduce((s, t) => s + t.amount, 0) / 7;

  return { list, expense, income, remain, available, safeDaily, avg7, daysLeft, start, end, today };
}

/* ---------------- 风险检测 ---------------- */
function riskList() {
  const st = cycleStats();
  const s = S.settings;
  const out = [];
  if (!s.alerts) return out;

  if (st.available < 0) {
    out.push({
      level: 'danger', ico: '🚨', title: '预留资金告警',
      text: `你已动用「${s.reserveName || '预留金'}」¥${fmt(-st.available)}，这笔钱是预先锁定的，请立即压缩非必要支出。`
    });
  }

  if (st.available >= 0 && st.safeDaily > 0 && st.avg7 > st.safeDaily) {
    const over = (st.avg7 - st.safeDaily) * st.daysLeft;
    out.push({
      level: 'warn', ico: '⚠️', title: '超前消费预警',
      text: `近 7 天日均 ¥${fmt(st.avg7)}，超出安全日额度 ¥${fmt(st.safeDaily)}。按当前节奏，生活费发放前将超支约 ¥${fmt(over)}。`
    });
  }

  if (st.available >= 0 && st.remain >= 0 && st.daysLeft <= 3 && st.remain < 100) {
    out.push({
      level: 'info', ico: '📅', title: '余额即将见底',
      text: `距下次发放还有 ${st.daysLeft} 天，剩余 ¥${fmt(st.remain)}，建议优先保障餐饮与交通。`
    });
  }

  return out;
}

/* ---------------- 视图切换 ---------------- */
function go(v) {
  $$('.view').forEach(el => el.classList.toggle('active', el.id === 'v-' + v));
  $$('.tabbar button[data-view]').forEach(b => b.classList.toggle('active', b.dataset.view === v));
  window.scrollTo({ top: 0, behavior: 'smooth' });

  if (v === 'home') renderHome();
  if (v === 'list') renderList();
  if (v === 'ai')   runDiagnosis(false);
  if (v === 'set')  renderSettings();
  if (v === 'add')  renderAddView();
}

/* =========================================================
   首页渲染
   ========================================================= */
function renderHome() {
  const st = cycleStats();
  const s = S.settings;

  // 大数字
  const el = $('#heroAmount');
  const val = st.available;
  el.textContent = (val < 0 ? '-¥' : '¥') + fmt(Math.abs(val));
  el.classList.toggle('neg', val < 0);

  $('#heroSub').textContent =
    `生活费 ¥${fmt(s.livingFee)} · 已花 ¥${fmt(st.expense)} · 预留 ¥${fmt(s.reserveAmount)}`;

  const pct = s.livingFee > 0 ? Math.min(st.expense / s.livingFee * 100, 100) : 0;
  $('#heroBar').style.width = pct + '%';

  $('#heroSpent').textContent = `已支出 ¥${fmt(st.expense)}`;
  $('#heroLeft').textContent  = `距发放 ${st.daysLeft} 天 · 日均可用 ¥${fmt(st.safeDaily)}`;

  // 预警
  const risks = riskList();
  $('#alertBox').innerHTML = risks.map(r => `
    <div class="alert ${r.level}">
      <span class="ico">${r.ico}</span>
      <div><b>${r.title}</b>${r.text}</div>
    </div>`).join('');

  // 预留卡
  $('#reserveVal').textContent = '¥' + fmt(s.reserveAmount);
  const reserveNote = $('#reserveNote');
  if (st.available < 0) {
    reserveNote.textContent = `已被动用 ¥${fmt(-st.available)}`;
    reserveNote.className = 'mini-note warn';
  } else {
    reserveNote.textContent = `「${s.reserveName || '预留'}」安全`;
    reserveNote.className = 'mini-note ok';
  }
  const reservePct = s.reserveAmount > 0
    ? Math.max(0, Math.min(100, (1 - st.available / s.reserveAmount) * 100)) : 0;
  $('#reserveBar').style.width = Math.min(reservePct, 100) + '%';

  // 存钱卡
  $('#savingVal').textContent = '¥' + fmt(s.savingCurrent);
  const sp = s.savingTarget > 0 ? Math.min(s.savingCurrent / s.savingTarget * 100, 100) : 0;
  $('#savingNote').textContent = `目标 ¥${fmt(s.savingTarget)} · 已完成 ${sp.toFixed(0)}%`;
  $('#savingNote').className = 'mini-note' + (sp >= 100 ? ' ok' : '');
  $('#savingBar').style.width = sp + '%';

  // 最近账单
  const recent = [...S.transactions]
    .sort((a, b) => (b.date + b.id).localeCompare(a.date + a.id))
    .slice(0, 5);
  $('#recentList').innerHTML = recent.length
    ? recent.map(txHTML).join('')
    : '<div class="empty">还没有账单，去记一笔吧 ✍️</div>';
}

function txHTML(t) {
  const c = CAT_MAP[t.cat] || { icon: '📦', color: '#94a3b8' };
  const d = parseYmd(t.date);
  const meta = `${catName(t.cat)} · ${d.getMonth() + 1}月${d.getDate()}日`;
  return `
    <div class="tx-item">
      <div class="tx-icon" style="background:${c.color}1a">${c.icon}</div>
      <div class="tx-main">
        <div class="tx-note">${escapeHtml(t.note || catName(t.cat))}</div>
        <div class="tx-meta">${meta}${t.source === 'ocr' ? ' · AI识别' : ''}</div>
      </div>
      <div class="tx-amount ${t.type}">${t.type === 'expense' ? '-' : '+'}¥${fmt(t.amount)}</div>
      <button class="tx-del" onclick="delTx('${t.id}')">×</button>
    </div>`;
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, m => (
    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]
  ));
}

function delTx(id) {
  S.transactions = S.transactions.filter(t => t.id !== id);
  save();
  renderHome();
  renderList();
  toast('已删除');
}

/* =========================================================
   账单页
   ========================================================= */
function renderList() {
  const st = cycleStats();
  $('#lsExpense').textContent = '¥' + fmt(st.expense);
  $('#lsIncome').textContent  = '¥' + fmt(st.income);
  $('#lsCount').textContent   = st.list.length;

  const all = [...S.transactions].sort((a, b) => (b.date + b.id).localeCompare(a.date + a.id));
  const box = $('#txList');

  if (!all.length) {
    box.innerHTML = '<div class="empty">暂无账单记录</div>';
    return;
  }

  const groups = {};
  all.forEach(t => { (groups[t.date] = groups[t.date] || []).push(t); });

  box.innerHTML = Object.keys(groups)
    .sort((a, b) => a < b ? 1 : -1)
    .map(date => {
      const items = groups[date];
      const daySum = items.filter(t => t.type === 'expense').reduce((s, t) => s + t.amount, 0);
      return `<div class="day-head">${dateLabel(date)} · 支出 ¥${fmt(daySum)}</div>
              ${items.map(txHTML).join('')}`;
    }).join('');
}

function dateLabel(ds) {
  const d = parseYmd(ds);
  const today = new Date(); today.setHours(0, 0, 0, 0);
  const diff = Math.round((today - d) / DAY);
  if (diff === 0) return '今天';
  if (diff === 1) return '昨天';
  return `${d.getMonth() + 1}月${d.getDate()}日`;
}

function clearAll() {
  if (!confirm('确定清空全部账单与设置吗？此操作不可恢复。')) return;
  S = buildSeed();
  save();
  renderHome(); renderList(); renderSettings();
  toast('已重置为示例数据');
}

/* =========================================================
   记一笔
   ========================================================= */
let addType = 'expense';
let addCat = 'food';

function renderAddView() {
  addType = 'expense';
  addCat = 'food';
  $$('#typeSeg button').forEach(b => b.classList.toggle('active', b.dataset.type === 'expense'));
  $('#amountInput').value = '';
  $('#noteInput').value = '';
  $('#dateInput').value = ymd(new Date());
  renderChips();
}

function renderChips() {
  const box = $('#catChips');
  const list = CATS[addType];
  if (!list.some(c => c.key === addCat)) addCat = list[0].key;
  box.innerHTML = list.map(c => `
    <div class="chip ${c.key === addCat ? 'active' : ''}" onclick="pickCat('${c.key}')">
      <span>${c.icon}</span>${c.name}
    </div>`).join('');
}

function pickCat(k) {
  addCat = k;
  renderChips();
}

$$('#typeSeg button').forEach(btn => {
  btn.addEventListener('click', () => {
    addType = btn.dataset.type;
    $$('#typeSeg button').forEach(b => b.classList.toggle('active', b === btn));
    renderChips();
  });
});

function saveTx() {
  const amount = parseFloat($('#amountInput').value);
  if (!amount || amount <= 0) { toast('请输入正确的金额'); return; }
  const note = $('#noteInput').value.trim() || catName(addCat);
  const date = $('#dateInput').value || ymd(new Date());

  S.transactions.push({
    id: uid(), type: addType, cat: addCat,
    amount: Math.round(amount * 100) / 100,
    note, date, source: 'manual', ts: Date.now()
  });
  save();

  // 记完立刻检查预留资金
  const st = cycleStats();
  if (S.settings.alerts && st.available < 0 && addType === 'expense') {
    toast(`⚠️ 已动用「${S.settings.reserveName}」预留金 ¥${fmt(-st.available)}`);
  } else {
    toast('记账成功 ✓');
  }

  $('#amountInput').value = '';
  $('#noteInput').value = '';
  setTimeout(() => go('home'), 320);
}

/* =========================================================
   图片导入（AI 识别）
   ========================================================= */
let pendingOcr = [];

function pickFile() { $('#fileInput').click(); }

$('#fileInput').addEventListener('change', e => {
  const f = e.target.files[0];
  if (!f) return;
  const reader = new FileReader();
  reader.onload = ev => {
    const img = $('#preview');
    img.src = ev.target.result;
    img.hidden = false;
    $('#ocrBtn').hidden = false;
    $('#ocrResult').innerHTML = '';
  };
  reader.readAsDataURL(f);
});

function runOCR() {
  const box = $('#ocrResult');
  box.innerHTML = '<div class="scanning"><div class="scan-bar"></div>AI 正在识别账单信息…</div>';
  $('#ocrBtn').disabled = true;

  setTimeout(() => {
    const items = mockOCR();
    renderOcrResult(items);
    $('#ocrBtn').disabled = false;
  }, 1500);
}

/* 模拟 OCR 结果（演示用） */
const OCR_POOL = [
  ['food',      12, '食堂早餐'],
  ['food',      25, '美团外卖'],
  ['food',      18, '蜜雪冰城'],
  ['food',      32, '食堂午饭'],
  ['transport',  6, '地铁乘车码'],
  ['transport', 15, '共享单车月卡'],
  ['shopping',  89, '淘宝购物'],
  ['entertain', 30, '腾讯视频会员'],
  ['study',     25, '打印店'],
  ['daily',     42, '校园超市'],
  ['social',    68, '同学聚餐'],
  ['food',      16, '瑞幸咖啡']
];

function mockOCR() {
  const n = 3 + Math.floor(Math.random() * 3);
  const used = new Set();
  const out = [];
  while (out.length < n) {
    const i = Math.floor(Math.random() * OCR_POOL.length);
    if (used.has(i)) continue;
    used.add(i);
    const [cat, base, name] = OCR_POOL[i];
    const amount = Math.round(base * (0.8 + Math.random() * 0.5) * 100) / 100;
    out.push({
      id: uid(), type: 'expense', cat, amount, note: name,
      date: ymd(new Date()), selected: true
    });
  }
  return out;
}

function renderOcrResult(items) {
  pendingOcr = items;
  const box = $('#ocrResult');
  if (!items.length) {
    box.innerHTML = '<div class="empty">未识别到有效账单</div>';
    return;
  }
  box.innerHTML = `
    <div class="ocr-head">AI 识别到 ${items.length} 笔消费，请核对后导入：</div>
    ${items.map((it, i) => `
      <label class="ocr-item">
        <input type="checkbox" checked data-i="${i}" onchange="toggleOcr(${i}, this.checked)">
        <span class="ocat" style="background:${catColor(it.cat)}22;color:${catColor(it.cat)}">
          ${catIcon(it.cat)} ${catName(it.cat)}
        </span>
        <span class="onote">${escapeHtml(it.note)}</span>
        <b>¥${fmt(it.amount)}</b>
      </label>`).join('')}
    <button class="btn primary" style="margin-top:10px" onclick="confirmOcr()">确认导入</button>`;
}

function toggleOcr(i, checked) { pendingOcr[i].selected = checked; }

function confirmOcr() {
  const picked = pendingOcr.filter(it => it.selected);
  if (!picked.length) { toast('请至少选择一笔'); return; }

  picked.forEach(it => {
    S.transactions.push({
      id: uid(), type: it.type, cat: it.cat, amount: it.amount,
      note: it.note, date: it.date, source: 'ocr', ts: Date.now()
    });
  });
  save();

  pendingOcr = [];
  $('#ocrResult').innerHTML = '';
  $('#preview').hidden = true;
  $('#ocrBtn').hidden = true;
  $('#fileInput').value = '';

  toast(`已导入 ${picked.length} 笔账单 ✓`);
  setTimeout(() => go('home'), 400);
}

/* =========================================================
   文本账单解析
   ========================================================= */
function parseText() {
  const text = $('#billText').value.trim();
  if (!text) { toast('请先粘贴账单文本'); return; }

  const items = [];
  text.split('\n').forEach(line => {
    line = line.trim();
    if (!line) return;
    const nums = line.match(/\d+(?:\.\d{1,2})?/g);
    if (!nums) return;

    const amount = parseFloat(nums[nums.length - 1]);
    if (!amount || amount > 99999) return;

    const note = line
      .replace(/[-+]?\d+(?:\.\d{1,2})?/g, ' ')
      .replace(/[¥￥:：,，]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim() || '导入账单';

    // 尝试解析日期
    let date = ymd(new Date());
    const full = line.match(/(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})/);
    if (full) {
      date = `${full[1]}-${pad(+full[2])}-${pad(+full[3])}`;
    } else {
      const short = line.match(/(\d{1,2})[-/.](\d{1,2})/);
      if (short) {
        const y = new Date().getFullYear();
        date = `${y}-${pad(+short[1])}-${pad(+short[2])}`;
      }
    }

    items.push({
      id: uid(), type: 'expense', cat: guessCat(note),
      amount, note, date, selected: true
    });
  });

  if (!items.length) { toast('没有解析到有效账单，请检查格式'); return; }
  renderOcrResult(items);
  $('#billText').value = '';
  toast(`解析出 ${items.length} 笔，请确认`);
  setTimeout(() => $('#ocrResult').scrollIntoView({ behavior: 'smooth', block: 'center' }), 200);
}

/* =========================================================
   AI 财务诊断
   ========================================================= */
function runDiagnosis(manual) {
  const st = cycleStats();
  const s = S.settings;
  const expense = st.expense;
  const income = Math.max(st.income, Number(s.livingFee) || 0);

  // ---------- 分类占比 ----------
  const catSum = {};
  st.list.filter(t => t.type === 'expense').forEach(t => {
    catSum[t.cat] = (catSum[t.cat] || 0) + t.amount;
  });
  const total = expense || 1;
  const ranked = Object.entries(catSum)
    .map(([k, v]) => ({
      key: k, name: catName(k), icon: catIcon(k), color: catColor(k),
      amount: v, pct: v / total * 100
    }))
    .sort((a, b) => b.amount - a.amount);

  renderCatChart(ranked);

  // ---------- 无数据 ----------
  if (expense === 0) {
    setScore(0, '待诊断', '本周期还没有消费记录，先记几笔账，医生才能给你做体检哦。');
    $('#adviceList').innerHTML = `
      <div class="advice"><span class="ai">📝</span>
      <div><b>先积累数据</b>记账是财务诊断的第一步。建议每天花 10 秒记一笔，或者用「账单截图导入」一键同步支付宝 / 微信账单。</div></div>`;
    return;
  }

  // ---------- 评分 ----------
  let score = 100;
  const advice = [];
  const good = [];

  const food = (ranked.find(r => r.key === 'food') || {}).pct || 0;
  const fun = ranked
    .filter(r => ['entertain', 'shopping', 'social'].includes(r.key))
    .reduce((a, b) => a + b.pct, 0);
  const savingsRate = income > 0 ? (income - expense) / income * 100 : 0;

  // 1. 餐饮结构
  if (food > 55) {
    score -= 12;
    advice.push({
      ico: '🍜', title: '餐饮占比偏高',
      text: `餐饮支出占 ${food.toFixed(0)}%，高于健康区间 30%~45%。建议每周给自己设 3 次外卖上限，多去食堂；把奶茶从「每天」改成「每周两次」，一个月大约能省 ¥${fmt(expense * food / 100 * 0.18)}。`
    });
  } else if (food < 22) {
    score -= 6;
    advice.push({
      ico: '🥗', title: '餐饮支出偏低',
      text: `餐饮仅占 ${food.toFixed(0)}%，注意别用节食换省钱，保证基本营养摄入，身体才是最大的资产。`
    });
  } else {
    good.push({ ico: '✅', title: '餐饮结构健康', text: `餐饮占比 ${food.toFixed(0)}%，处于合理区间，继续保持。` });
  }

  // 2. 非必要消费
  if (fun > 40) {
    score -= 15;
    advice.push({
      ico: '🎮', title: '非必要消费偏高',
      text: `娱乐 + 购物 + 社交合计占 ${fun.toFixed(0)}%，超过了收入的三分之一。建议采用「24 小时冷静期」：想买非必需品先放购物车一天，第二天还想要再买。`
    });
  } else if (fun > 25) {
    score -= 6;
    advice.push({
      ico: '⚖️', title: '弹性消费需留意',
      text: `娱乐购物类合计 ${fun.toFixed(0)}%，略高于建议值 25%。可以给这类开销设一个月度上限，花完就停。`
    });
  } else if (fun >= 0) {
    good.push({ ico: '👍', title: '弹性消费克制', text: `娱乐购物类仅占 ${fun.toFixed(0)}%，自控力不错。` });
  }

  // 3. 结余率
  if (savingsRate < 0) {
    score -= 20;
    advice.push({
      ico: '🚨', title: '本周期已超支',
      text: `支出比收入多出 ¥${fmt(expense - income)}。先停掉所有非必要消费，把剩余日子拆成「每天固定额度」来花。`
    });
  } else if (savingsRate < 10) {
    score -= 10;
    advice.push({
      ico: '💧', title: '结余率偏低',
      text: `本周期结余率仅 ${savingsRate.toFixed(0)}%，建议把目标定在 20%。可以试试「发生活费当天先存 200」，剩下的再花。`
    });
  } else if (savingsRate >= 20) {
    good.push({ ico: '🏆', title: '结余率优秀', text: `结余率 ${savingsRate.toFixed(0)}%，超过 20% 的健康线，理财意识很棒。` });
  } else {
    good.push({ ico: '💚', title: '结余率达标', text: `结余率 ${savingsRate.toFixed(0)}%，接近健康区间，再加把劲。` });
  }

  // 4. 超支风险
  if (st.available < 0) {
    score -= 15;
    advice.push({
      ico: '🛡️', title: `已动用「${s.reserveName || '预留金'}」`,
      text: `预留的 ¥${fmt(s.reserveAmount)} 已经被花掉 ¥${fmt(-st.available)}。这笔钱通常有固定用途（如车票），请优先从餐饮娱乐里省回来。`
    });
  } else if (st.safeDaily > 0 && st.avg7 > st.safeDaily) {
    score -= 12;
    advice.push({
      ico: '⏱️', title: '消费速度超过安全线',
      text: `安全日额度 ¥${fmt(st.safeDaily)}，但近 7 天日均花了 ¥${fmt(st.avg7)}。按此速度，发放日前会透支约 ¥${fmt((st.avg7 - st.safeDaily) * st.daysLeft)}，建议把日均压回 ¥${fmt(st.safeDaily)} 以内。`
    });
  } else {
    good.push({
      ico: '🎯', title: '消费节奏可控',
      text: `近 7 天日均 ¥${fmt(st.avg7)}，低于安全日额度 ¥${fmt(st.safeDaily)}，节奏把控得不错。`
    });
  }

  // 5. 记账坚持度
  const d7 = new Date(st.today.getTime() - 6 * DAY);
  const days7 = new Set(
    S.transactions
      .filter(t => parseYmd(t.date) >= d7 && parseYmd(t.date) <= st.today)
      .map(t => t.date)
  ).size;
  if (days7 < 3) {
    score -= 8;
    advice.push({
      ico: '📅', title: '记账频率偏低',
      text: `最近 7 天只有 ${days7} 天有记录。记账断档会让诊断失真，建议开启每日提醒，或用截图导入补录。`
    });
  } else {
    good.push({ ico: '📌', title: '记账习惯良好', text: `最近 7 天有 ${days7} 天在记账，数据越完整，诊断越准确。` });
  }

  score = Math.max(35, Math.min(100, Math.round(score)));

  // 等级
  let level, desc;
  if (score >= 90)      { level = '财务状况优秀'; desc = `本周期支出 ¥${fmt(expense)}，结构健康、节奏稳健，继续保持！`; }
  else if (score >= 75) { level = '财务状况良好'; desc = `本周期支出 ¥${fmt(expense)}，整体可控，仍有小幅优化空间。`; }
  else if (score >= 60) { level = '财务状况一般'; desc = `本周期支出 ¥${fmt(expense)}，存在若干风险点，建议按下方建议调整。`; }
  else                  { level = '需要重点改善'; desc = `本周期支出 ¥${fmt(expense)}，超支或结构失衡风险较高，请立刻执行医生建议。`; }

  setScore(score, level, desc);

  // 渲染建议（问题在前，优点在后）
  const all = [...advice, ...good];
  $('#adviceList').innerHTML = all.map(a => `
    <div class="advice ${advice.includes(a) ? 'bad' : 'good'}">
      <span class="ai">${a.ico}</span>
      <div><b>${a.title}</b>${a.text}</div>
    </div>`).join('');

  if (manual) toast('诊断报告已更新 🩺');
}

function setScore(score, level, desc) {
  $('#scoreNum').textContent = score > 0 ? score : '--';
  $('#scoreLevel').textContent = level;
  $('#scoreDesc').textContent = desc;

  const deg = score > 0 ? score / 100 * 360 : 0;
  const color = score >= 90 ? '#34d399' : score >= 75 ? '#38bdf8' : score >= 60 ? '#fbbf24' : '#f87171';
  $('#scoreRing').style.background = `conic-gradient(${color} ${deg}deg, rgba(255,255,255,.12) ${deg}deg)`;
}

function renderCatChart(ranked) {
  const el = $('#catChart');
  if (!ranked.length) {
    el.innerHTML = '<div class="empty">暂无支出数据</div>';
    return;
  }
  el.innerHTML = ranked.slice(0, 7).map(r => `
    <div class="cat-row">
      <div class="cat-name">${r.icon} ${r.name}</div>
      <div class="cat-bar"><i style="width:${Math.max(r.pct, 3)}%;background:${r.color}"></i></div>
      <div class="cat-pct">${r.pct.toFixed(0)}%</div>
      <div class="cat-amt">¥${fmt(r.amount)}</div>
    </div>`).join('');
}

/* =========================================================
   设置页
   ========================================================= */
function renderSettings() {
  const s = S.settings;
  $('#setFee').value = s.livingFee;
  $('#setReserveName').value = s.reserveName;
  $('#setReserveAmount').value = s.reserveAmount;
  $('#setSavingName').value = s.savingName;
  $('#setSavingTarget').value = s.savingTarget;
  $('#setSavingCurrent').value = s.savingCurrent;
  $('#setAlerts').checked = !!s.alerts;

  const sel = $('#setPayday');
  if (!sel.options.length) {
    sel.innerHTML = Array.from({ length: 28 }, (_, i) =>
      `<option value="${i + 1}">每月 ${i + 1} 日</option>`).join('');
  }
  sel.value = s.payday;
}

function saveSettings() {
  const fee = parseFloat($('#setFee').value);
  if (!fee || fee <= 0) { toast('请填写有效的生活费金额'); return; }

  S.settings = {
    livingFee: fee,
    payday: parseInt($('#setPayday').value, 10) || 1,
    reserveName: $('#setReserveName').value.trim() || '预留金',
    reserveAmount: Math.max(0, parseFloat($('#setReserveAmount').value) || 0),
    savingName: $('#setSavingName').value.trim() || '存钱目标',
    savingTarget: Math.max(0, parseFloat($('#setSavingTarget').value) || 0),
    savingCurrent: Math.max(0, parseFloat($('#setSavingCurrent').value) || 0),
    alerts: $('#setAlerts').checked
  };
  save();
  toast('设置已保存 ✓');
  renderHome();
  setTimeout(() => go('home'), 350);
}

/* =========================================================
   示例数据
   ========================================================= */
function buildSeed() {
  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

  const state = { transactions: [], settings: Object.assign({}, DEFAULT_SETTINGS), seeded: true };

  // 先临时设置 payday 以便计算周期
  const payday = DEFAULT_SETTINGS.payday;
  let start;
  if (today.getDate() >= payday) {
    start = new Date(today.getFullYear(), today.getMonth(), payday);
  } else {
    start = new Date(today.getFullYear(), today.getMonth() - 1, payday);
  }
  const span = Math.max(1, Math.round((today - start) / DAY));

  const add = (frac, type, cat, amount, note) => {
    const off = -Math.round(span * frac);
    const d = new Date(today.getFullYear(), today.getMonth(), today.getDate() + off);
    state.transactions.push({
      id: uid(), type, cat, amount, note,
      date: ymd(d), source: 'manual', ts: d.getTime()
    });
  };

  add(0.99, 'income',  'living',    1500, '本月生活费');
  add(0.95, 'expense', 'food',        26, '食堂午饭');
  add(0.90, 'expense', 'transport',    6, '地铁乘车码');
  add(0.85, 'expense', 'food',        38, '美团外卖');
  add(0.80, 'expense', 'entertain',   45, '电影票');
  add(0.72, 'expense', 'study',       89, '四六级资料');
  add(0.66, 'expense', 'food',        22, '食堂晚饭');
  add(0.60, 'expense', 'shopping',   159, '运动鞋');
  add(0.52, 'expense', 'food',        31, '瑞幸咖啡');
  add(0.45, 'expense', 'social',     128, '同学聚餐');
  add(0.38, 'expense', 'food',        24, '食堂午饭');
  add(0.32, 'expense', 'daily',       56, '超市日用品');
  add(0.26, 'expense', 'entertain',   30, '游戏充值');
  add(0.20, 'expense', 'food',        35, '美团外卖');
  add(0.14, 'expense', 'transport',   15, '共享单车月卡');
  add(0.10, 'expense', 'food',        42, '食堂 + 奶茶');
  add(0.06, 'expense', 'study',       25, '打印资料');
  add(0.02, 'expense', 'food',        29, '外卖');
  add(0.00, 'expense', 'food',        18, '早餐');

  state.transactions.sort((a, b) => (b.date).localeCompare(a.date));
  return state;
}

function resetAll() {
  if (!confirm('确定清空全部数据并恢复示例吗？')) return;
  S = buildSeed();
  save();
  renderHome(); renderList(); renderSettings();
  toast('已重置');
}

